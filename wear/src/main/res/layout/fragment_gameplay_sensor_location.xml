<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/locationGameplayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#001A00">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.randomadjective.prototipodatalayer.sensors.fragments.gameplay.RadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvRadarStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Buscando ubicación..."
                android:textColor="#B9FFB9"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRadarHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Heading: -"
                android:textColor="#B9FFB9"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRadarZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="Zoom: 10 m/celda"
            android:textColor="#B9FFB9"
            android:textSize="11sp"
            android:textStyle="bold" />

    </FrameLayout>

</androidx.wear.widget.BoxInsetLayout>